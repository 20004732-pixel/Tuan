  </footer>
  <script src="/_sdk/editing_sdk.js"></script>
  <script>
    lucide.createIcons();
    
    // Welcome greeting animation
    function showWelcomeGreeting() {
      const greeting = document.createElement('div');
      greeting.className = 'fixed inset-0 flex items-center justify-center z-50 pointer-events-none';
      greeting.style.cssText = 'background: rgba(0,0,0,0.7); animation: fadeIn 0.5s ease forwards;';
      
      const greetingContent = document.createElement('div');
      greetingContent.style.cssText = `
        text-center;
        opacity: 0;
        animation: slideUp 0.8s ease forwards;
        animation-delay: 0.2s;
      `;
      
      greetingContent.innerHTML = `
        <h2 style="font-family: 'Fraunces', serif; font-size: 3rem; font-weight: 900; background: linear-gradient(135deg,#c084fc,#60a5fa,#22d3ee); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 1rem; animation: slideUp 0.8s ease forwards;">Xin Chào!</h2>
        <p style="font-family: 'DM Sans', sans-serif; font-size: 1.25rem; color: #a5b4fc; animation: slideUp 0.8s ease forwards; animation-delay: 0.3s; opacity: 0;">Chào mừng bạn đến với portfolio của tôi</p>
      `;
      
      greeting.appendChild(greetingContent);
      document.body.appendChild(greeting);
      
      setTimeout(() => {
        greeting.style.animation = 'fadeOut 0.6s ease forwards';
        setTimeout(() => greeting.remove(), 600);
      }, 2500);
    }
    
    // Add animations to style
    const style = document.createElement('style');
    style.textContent = `
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes fadeOut {
        from { opacity: 1; background: rgba(0,0,0,0.7); }
        to { opacity: 0; background: rgba(0,0,0,0); }
      }
      @keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
      }
    `;
    document.head.appendChild(style);
    
    // Show greeting on page load
    window.addEventListener('load', showWelcomeGreeting);
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
