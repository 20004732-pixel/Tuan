   <div class="hero-glow top-10 left-1/4 bg-purple-600"></div>
   <div class="hero-glow bottom-10 right-1/4 bg-blue-600"></div>
   <div class="relative z-10 flex flex-col items-center justify-center h-full px-5 py-20 text-center" style="min-height:calc(90 * min(var(--vh,1vh),1vh));">
    <div class="glass rounded-3xl p-8 md:p-12 max-w-md reveal" style="animation-delay:0.2s">
